{
  "name": "mmolite",
  "version": "1.0.0",
  "description": "MMOLite - Pokemon-style MMO game server (Love2D client)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest --testPathPatterns=tests/ --forceExit --detectOpenHandles",
    "test:unit": "jest --testPathPatterns=tests/(rpg-data|dungeon-combat|regressions|event-contracts) --forceExit",
    "test:integration": "jest --testPathPatterns=tests/socket-integration --forceExit --detectOpenHandles",
    "test:client": "lua tests/client/sprite-sheet.test.lua",
    "test:strain": "node tests/bot-strain.js",
    "lint:js": "eslint .",
    "lint:lua": "luacheck client",
    "lint": "npm run lint:js && npm run lint:lua",
    "verify": "npm run lint && npm test && npm run test:client"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "10.8.0",
    "jest": "30.4.2",
    "socket.io-client": "^4.8.3"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "ioredis": "^5.9.3",
    "pg": "^8.18.0",
    "socket.io": "^4.7.2",
    "stripe": "^20.4.0",
    "uuid": "^11.1.1"
  }
}
